# OpenAI API kaliti (ixtiyoriy).
#
# BO'SH QOLDIRILSA: ilova to'liq ishlaydi, lekin chat javoblari
# `lib/ai/demo-engine.ts` — kalit so'zlarga asoslangan aniq hisoblash
# dvigateli tomonidan tayyorlanadi. Barcha matematik natijalar
# (kredit, foyda, soliq, break-even) baribir haqiqiy formulalar bilan
# hisoblanadi — faqat tabiiy tilni tushunish soddaroq bo'ladi.
#
# TO'LDIRILSA: `/api/chat` OpenAI (gpt-4o-mini) ga tool-calling bilan
# murojaat qiladi; matematika baribir serverdagi kalkulyatorlarda bajariladi.
#
# Kalit olish: https://platform.openai.com/api-keys
OPENAI_API_KEY=
